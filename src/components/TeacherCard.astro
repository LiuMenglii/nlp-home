---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils';

interface Props {
  teacher: CollectionEntry<'teachers'>;
  /** full = 人员页完整信息（email/bio）；compact = 主页概览卡片 */
  detailed?: boolean;
}

const { teacher, detailed = false } = Astro.props;
const { name, title, directions, email, homepage, photo, bio } = teacher.data;
---

<article class:list={['teacher-card', 'card', { 'teacher-card--detailed': detailed }]}>
  <div class="teacher-head">
    {photo && (
      <img
        class="teacher-photo"
        src={withBase(photo)}
        alt={`${name} photo`}
        width="160"
        height="200"
        loading="lazy"
      />
    )}
    <div class="teacher-identity">
      <h3>{name}</h3>
      <p class="teacher-title">{title}</p>
      <ul class="teacher-directions" aria-label="Research directions">
        {directions.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </div>
  {detailed && bio && <p class="teacher-bio">{bio}</p>}
  <div class="teacher-links">
    {
      detailed && email && (
        <a href={`mailto:${email}`}>
          {email}
        </a>
      )
    }
    {
      homepage && (
        <a href={homepage} target="_blank" rel="noopener">
          Homepage <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  /* 上下结构：上方图片 + 姓名与研究方向，下方详细介绍文字 */
  .teacher-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .teacher-head {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .teacher-photo {
    flex-shrink: 0;
    width: 120px;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .teacher-identity {
    min-width: 0;
  }

  h3 {
    font-size: 1.25rem;
    margin: 0 0 4px;
  }

  .teacher-title {
    color: var(--blue-deep);
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .teacher-directions {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .teacher-directions li {
    background: var(--sky);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* 介绍卡片（Team 页）：研究方向每行一个，单个标签不断行 */
  .teacher-card--detailed .teacher-directions {
    flex-direction: column;
    align-items: flex-start;
  }

  .teacher-card--detailed .teacher-directions li {
    white-space: nowrap;
  }

  .teacher-bio {
    font-size: 1rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 80ch;
  }

  .teacher-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 1rem;
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .teacher-head {
      flex-direction: column;
    }
  }
</style>
