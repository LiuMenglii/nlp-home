---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils';

interface Props {
  teacher: CollectionEntry<'teachers'>;
  /** full = 人员页完整信息（email/bio）；compact = 主页概览卡片 */
  detailed?: boolean;
}

const { teacher, detailed = false } = Astro.props;
const { name, title, directions, email, homepage, photo, bio } = teacher.data;
---

<article class:list={['teacher-card', 'card', { 'teacher-card--detailed': detailed }]}>
  <div class="teacher-head">
    {photo && (
      <img
        class="teacher-photo"
        src={withBase(photo)}
        alt={`${name} photo`}
        width="160"
        height="200"
        loading="lazy"
      />
    )}
    <div class="teacher-identity">
      <h3>{name}</h3>
      <p class="teacher-title">{title}</p>
      <ul class="teacher-directions" aria-label="Research directions">
        {directions.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </div>
  {detailed && bio && <p class="teacher-bio">{bio}</p>}
  <div class="teacher-links">
    {
      detailed && email && (
        <a href={`mailto:${email}`}>
          {email}
        </a>
      )
    }
    {
      homepage && (
        <a href={homepage} target="_blank" rel="noopener">
          Homepage <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  /* 上下结构：上方图片 + 姓名与研究方向，下方详细介绍文字 */
  .teacher-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .teacher-head {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .teacher-photo {
    flex-shrink: 0;
    width: 120px;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .teacher-identity {
    min-width: 0;
  }

  h3 {
    font-size: 1.25rem;
    margin: 0 0 4px;
  }

  .teacher-title {
    color: var(--blue-deep);
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .teacher-directions {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .teacher-directions li {
    background: var(--sky);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.9rem;
    color: var(--ink-soft);
    /* 003 FR-004 两级收纳：整标签优先由上方 .teacher-directions 的 flex-wrap 换行；
       仅单个标签自身超宽时在标签内文字换行收纳（MUST NOT 依赖 nowrap 防溢出） */
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .teacher-bio {
    font-size: 1rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 80ch;
  }

  .teacher-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 1rem;
    margin-top: auto;
    /* 收缩为内容宽度（消除拉伸至卡片全宽后链接内容右侧的连续空白，FR-004） */
    align-self: flex-start;
  }

  @media (max-width: 575.98px) {
    /* 003 FR-003 / CHK008 / CHK038：<576px 很窄档头部——照片水平居中于卡片内容区上方；
       其下信息区两列 Grid（1fr auto）：姓名居左、职称右对齐同行；
       方向标签紧随该行之下、占内容整宽（CHK009）、左对齐 */
    .teacher-head {
      flex-direction: column;
      align-items: center;
    }

    .teacher-identity {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      width: 100%;
    }

    .teacher-title {
      text-align: right;
    }

    .teacher-directions {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
