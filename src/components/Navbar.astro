---
import { withBase, normalizePath } from '../utils';
import site from '../data/site.json';

const items = [
  { label: 'Home', href: withBase('/') },
  { label: 'News', href: withBase('/news/') },
  { label: 'Team', href: withBase('/team/') },
  { label: 'Publications', href: withBase('/publications/') },
];

const current = normalizePath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <img class="brand-logo" src={withBase(site.logo)} alt="" width={32} height={32} />
      <span class="brand-text">{site.navBrand}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === normalizePath(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 12px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    white-space: nowrap;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--blue-deep);
    letter-spacing: 0.02em;
  }

  /* 等高对齐（CHK040 修订口径）：logo 渲染高度 = "CIGMA" 文字行盒高度（均 1.2em，随字号等比缩放） */
  .brand-logo {
    height: 1.2em;
    width: auto;
    display: block;
  }

  .brand-text {
    line-height: 1.2;
  }

  .brand:hover {
    color: var(--blue);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-block;
    padding: 6px 2px;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .nav-list a:hover {
    color: var(--blue-deep);
    text-decoration: none;
  }

  .nav-list a[aria-current='page'] {
    color: var(--blue-deep);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--blue);
  }
</style>
