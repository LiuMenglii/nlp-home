---
import site from '../data/site.json';
---

<section class="section hero" aria-labelledby="hero-title">
  <p class="hero-affil">{site.instituteZh} · {site.lab}</p>
  <h1 id="hero-title">{site.groupName} {site.navBrand}</h1>
  <p class="hero-alias">{site.alias} · {site.fullName}</p>
  <ul class="hero-directions" aria-label="Research directions">
    {site.directions.map((d) => <li>{d}</li>)}
  </ul>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--sky) 0%, #ffffff 100%);
    border-bottom: 1px solid var(--line);
    margin-block: 0;
    margin-top: -8px;
    padding-block: 72px 56px;
    text-align: center;
  }

  /* 四层命名体系：① 机构从属链（次要）→ ② 主名称 → ③ 别名·英文全称 → ④ 方向标签 */
  .hero-affil {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin-bottom: 12px;
    letter-spacing: 0.01em;
  }

  /* 长命名词间断行（自然空格断行 + overflow-wrap 兜底；不使用 word-break:break-all / 连字符断词） */
  .hero-alias {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin-bottom: 28px;
    overflow-wrap: break-word;
  }

  .hero-directions {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 0;
    padding: 0;
  }

  .hero-directions li {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--blue-deep);
    padding: 6px 18px;
    font-size: 1rem;
  }
</style>
