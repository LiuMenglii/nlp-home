---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import { withBase } from '../utils';

// 展示顺序 = gallery.json 数组顺序（entry id 按序号生成）
const photos = (await getCollection('gallery')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

{
  photos.length > 0 && (
    <section class="section" aria-labelledby="gallery-title">
      <SectionHeading title="Gallery" id="gallery-title" />
      <div class="gallery-grid" data-gallery-grid>
        {photos.map((photo) => (
          <button
            type="button"
            class="gallery-thumb"
            data-gallery-src={withBase(`/gallery/${photo.data.src}`)}
            data-gallery-caption={photo.data.caption}
            aria-label={`查看大图：${photo.data.caption}`}
          >
            <img
              src={withBase(`/gallery/${photo.data.src}`)}
              alt={photo.data.caption}
              loading="lazy"
            />
          </button>
        ))}
      </div>

      <dialog class="gallery-dialog" data-gallery-dialog>
        <figure>
          <img data-gallery-image src="" alt="" />
          <figcaption data-gallery-caption />
        </figure>
        <button
          type="button"
          class="gallery-close"
          data-gallery-close
          aria-label="关闭大图"
        >
          ×
        </button>
      </dialog>
    </section>
  )
}

<script>
  const grid = document.querySelector('[data-gallery-grid]');
  const dialog = document.querySelector('[data-gallery-dialog]');

  if (grid && dialog) {
    const image = dialog.querySelector('[data-gallery-image]');
    const caption = dialog.querySelector('[data-gallery-caption]');

    // 事件委托：点击任一缩略图 → 填充大图并打开
    grid.addEventListener('click', (e) => {
      const thumb = (e.target as HTMLElement).closest<HTMLElement>('[data-gallery-src]');
      if (!thumb || !image || !caption) return;
      const src = thumb.dataset.gallerySrc ?? '';
      const text = thumb.dataset.galleryCaption ?? '';
      image.setAttribute('src', src);
      image.setAttribute('alt', text);
      caption.textContent = text;
      (dialog as HTMLDialogElement).showModal();
    });

    // 关闭方式 1：关闭按钮；方式 2：点击遮罩（dialog 自身）；方式 3：Esc（原生默认）
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => {
      (dialog as HTMLDialogElement).close();
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) (dialog as HTMLDialogElement).close();
    });
  }
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }

  .gallery-thumb {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--sky-soft);
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.15s ease;
  }

  .gallery-thumb:hover img {
    transform: scale(1.04);
  }

  .gallery-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: min(92vw, 1200px);
    background: #ffffff;
  }

  .gallery-dialog::backdrop {
    background: rgb(16 43 78 / 0.75);
  }

  .gallery-dialog figure {
    margin: 0;
  }

  .gallery-dialog img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
  }

  .gallery-dialog figcaption {
    padding: 12px 16px;
    color: var(--ink);
    font-size: 1rem;
    border-top: 1px solid var(--line);
  }

  .gallery-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .gallery-close:hover {
    background: #ffffff;
  }
</style>
