---
interface Props {
  rating?: 'A' | 'B' | 'C' | null;
}

const { rating } = Astro.props;
---

{
  rating && (
    <span class={`ccf-badge ccf-${rating}`} title={`China Computer Federation (CCF) Rank ${rating}`}>
      CCF-{rating}
    </span>
  )
}

<style>
  .ccf-badge {
    display: inline-block;
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff;
    background: var(--ink-soft);
    white-space: nowrap;
    /* FR-005：CCF-A / CCF-B / CCF-C 实测最大宽度归一化（box-sizing: border-box 含 padding），
       保证同类标签跨条目宽度极差 <1px；只改布局宽度，配色与字号不变 */
    min-inline-size: 59.66px;
    text-align: center;
  }

  .ccf-A {
    background: var(--blue-deep);
  }

  .ccf-B {
    background: var(--blue);
  }

  .ccf-C {
    background: var(--ink-soft);
  }
</style>
