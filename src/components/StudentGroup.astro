---
import type { CollectionEntry } from 'astro:content';

interface Props {
  students: CollectionEntry<'students'>[];
}

const { students } = Astro.props;

// data-model §4：按 level 分组，组内按 grade 降序（无年级排最后）
const byLevel = (level: 'phd' | 'master') =>
  students
    .filter((s) => s.data.level === level)
    .sort((a, b) => (b.data.grade ?? '').localeCompare(a.data.grade ?? ''));

const phd = byLevel('phd');
const master = byLevel('master');
---

<div class="student-groups">
  {
    phd.length > 0 ? (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <ul>
          {phd.map((s) => (
            <li>
              {s.data.url ? (
                <a href={s.data.url} target="_blank" rel="noopener">
                  {s.data.name}
                </a>
              ) : (
                <span>{s.data.name}</span>
              )}
              {s.data.github && (
                <a class="github-link" href={s.data.github} target="_blank" rel="noopener">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
              {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
              {s.data.note && <span class="note">{s.data.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <p class="empty">PhD candidates coming soon.</p>
      </div>
    )
  }

  {
    master.length > 0 ? (
      <div class="student-group">
        <h3>Master's Students</h3>
        <ul>
          {master.map((s) => (
            <li>
              {s.data.url ? (
                <a href={s.data.url} target="_blank" rel="noopener">
                  {s.data.name}
                </a>
              ) : (
                <span>{s.data.name}</span>
              )}
              {s.data.github && (
                <a class="github-link" href={s.data.github} target="_blank" rel="noopener">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
              {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
              {s.data.note && <span class="note">{s.data.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>Master's Students</h3>
        <p class="empty">Master's students coming soon.</p>
      </div>
    )
  }
</div>

<style>
  .student-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    color: var(--blue-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    /* 两端分布 + 两侧内收（FR-004 / T006）：姓名自分组左缘内收、Since/备注自分组右缘内收，
       行内容两侧各收拢 44px（按四档视口 375/768/1024/≥1280px 实测校准的定值）——
       两端分布行的中间间隙满足分档阈值，收拢产生的两端空白仍在右端口径内 */
    padding: 8px 44px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  li:first-of-type {
    border-top: 1px solid var(--line);
  }

  a {
    color: var(--ink);
  }

  a:hover {
    color: var(--blue-deep);
  }

  .grade,
  .note {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* 两端分布（FR-004）：姓名居左，Since/备注推至行内收拢后的右缘；
     无年级条目仅左侧姓名，行内布局保持整齐 */
  .grade {
    margin-left: auto;
  }

  /* GitHub↗ 标签复用站点链接色板（区别于姓名链接的 ink 色） */
  .github-link {
    color: var(--blue-deep);
  }

  .github-link:hover {
    color: var(--blue);
  }

  .empty {
    color: var(--ink-soft);
  }
</style>
