---
import type { CollectionEntry } from 'astro:content';

interface Props {
  students: CollectionEntry<'students'>[];
}

const { students } = Astro.props;

// 011 FR-003：按 level 分组，组内按 grade 升序（无年级排最后，同级保持数据文件顺序）
const byLevel = (level: 'phd' | 'master') =>
  students
    .filter((s) => s.data.level === level)
    .sort((a, b) => {
      const gradeA = a.data.grade ?? '';
      const gradeB = b.data.grade ?? '';
      if (!gradeA && !gradeB) return 0;
      if (!gradeA) return 1;
      if (!gradeB) return -1;
      return gradeA.localeCompare(gradeB);
    });

const phd = byLevel('phd');
const master = byLevel('master');

// 010 FR-003：PhD 名单按 ceil(n/2) 切分为左右两栏；n=1 单栏单条，不生成空栏。
// 切分不改变 byLevel 的排序结果（grade 升序 → 无年级最后 → 稳定序）。
const phdColumns =
  phd.length > 1
    ? [phd.slice(0, Math.ceil(phd.length / 2)), phd.slice(Math.ceil(phd.length / 2))]
    : phd.length === 1
      ? [phd]
      : [];
const phdSingle = phd.length <= 1;

// 011 FR-001～FR-003：Master's 与 PhD 同规则，按 ceil(n/2) 切分为左右两栏；
// n=1 单栏单条（.is-single），n=0 保留既有占位分支，不生成空栏。
// 切分不改变 byLevel 的排序结果（grade 升序 → 无年级最后 → 稳定序）。
const masterColumns =
  master.length > 1
    ? [
        master.slice(0, Math.ceil(master.length / 2)),
        master.slice(Math.ceil(master.length / 2)),
      ]
    : master.length === 1
      ? [master]
      : [];
const masterSingle = master.length <= 1;

// 007 FR-012：每人至多一个链接标签，按 url → github → scholar 取第一个非空字段
const linkOf = (s: CollectionEntry<'students'>) =>
  s.data.url
    ? { href: s.data.url, label: 'Homepage' }
    : s.data.github
      ? { href: s.data.github, label: 'GitHub' }
      : s.data.scholar
        ? { href: s.data.scholar, label: 'Scholar' }
        : null;
---

<div class="student-groups">
  {
    phd.length > 0 ? (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <div class:list={['phd-columns', { 'is-single': phdSingle }]}>
          {phdColumns.map((column) => (
            <ul>
              {column.map((s) => {
                const link = linkOf(s);
                return (
                  <li>
                    <span class="student-name">{s.data.name}</span>
                    {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
                    {link && (
                      <a class="member-link" href={link.href} target="_blank" rel="noopener">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>
    ) : (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <p class="empty">PhD candidates coming soon.</p>
      </div>
    )
  }

  {
    master.length > 0 ? (
      <div class="student-group">
        <h3>Master's Students</h3>
        <div class:list={['master-columns', { 'is-single': masterSingle }]}>
          {masterColumns.map((column) => (
            <ul>
              {column.map((s) => {
                const link = linkOf(s);
                return (
                  <li>
                    <span class="student-name">{s.data.name}</span>
                    {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
                    {link && (
                      <a class="member-link" href={link.href} target="_blank" rel="noopener">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>
    ) : (
      <div class="student-group">
        <h3>Master's Students</h3>
        <p class="empty">Master's students coming soon.</p>
      </div>
    )
  }
</div>

<style>
  .student-groups {
    display: grid;
    /* 007 FR-001～FR-003：PhD Candidates 与 Master's Students 在所有视口上下排列、
       各占内容区整行（不再按 320px 阈值并排）；minmax(0, 1fr) 保证轨道不超出容器，
       320px 档亦不横向溢出 */
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    color: var(--blue-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    /* 两端分布 + 两侧内收（002 FR-004 / T006）：姓名自分组左缘内收、Since/备注自分组右缘内收；
       003 FR-007 左右内距自 44px 统一收窄为 24px（左右对称）——与毕业生条目同一固定内距，
       本组件即跨区块列对齐基准（两列表姓名左边缘同线，验收 getBoundingClientRect().left 差值 ≤1px） */
    padding: 8px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  li:first-of-type {
    border-top: 1px solid var(--line);
  }

  /* 007 FR-013 / FR-019：姓名纯文本（非链接），固定 5em 轨道（按最多 4 个汉字设计） */
  .student-name {
    flex: 0 0 5em;
  }

  /* 007 FR-012 / FR-018：唯一链接标签固定在 6.5em 列内居中，
     沿用站点链接色板（--blue-deep，hover --blue） */
  .member-link {
    flex: 0 0 6.5em;
    text-align: center;
    color: var(--blue-deep);
  }

  .member-link:hover {
    color: var(--blue);
  }

  .grade {
    color: var(--ink-soft);
    /* 011 FR-013：站点根字号为 16px，1rem 只有 16px，故用显式 18px */
    font-size: 18px;
  }

  /* 两端分布（FR-004）：姓名居左，Since 推至行内收拢后的右缘；
     无年级条目仅左侧姓名，行内布局保持整齐 */
  .grade {
    margin-left: auto;
  }

  /* 007 FR-019：视口 <480px 堆叠态——姓名恢复自适应宽度，标签独占一行；
     DOM 顺序不变，标签以 order 后置，行序为「姓名与年级 → 备注 → 标签」。
     012 FR-005：链接文字改为右对齐（与第 1 行 Since 同贴行右缘） */
  @media (max-width: 479.98px) {
    .student-name {
      flex: 0 0 auto;
    }

    .member-link {
      order: 9;
      flex: 0 0 100%;
      text-align: right;
    }
  }

  .empty {
    color: var(--ink-soft);
  }

  /* 010 FR-001～FR-003 / 011：PhD 与 Master's 共用的名单两栏包装层；
     基础态单列整宽，≥768px 切换两栏（选择器并列，声明值与 010 逐条相同） */
  .phd-columns,
  .master-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .phd-columns ul,
  .master-columns ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 单栏陈列时两个 ul 连成一条连续列表，第二个列表首行不重复顶部分隔线 */
  .phd-columns ul + ul li:first-child,
  .master-columns ul + ul li:first-child {
    border-top: 0;
  }

  /* 超长姓名（含无空格拉丁串）在槽内换行，不越入相邻槽位 */
  .phd-columns .student-name,
  .master-columns .student-name {
    overflow-wrap: break-word;
  }

  /* 010 FR-001～FR-003：≥768px 两栏等宽、栏距 32px、两列顶线一致；
     与教师名片单列断点（767.98px）同阈值 */
  @media (min-width: 768px) {
    .phd-columns,
    .master-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      align-items: start;
    }

    .phd-columns ul + ul li:first-child,
    .master-columns ul + ul li:first-child {
      border-top: 1px solid var(--line);
    }

    /* n=1 时回到单列整宽，不产生空栏 */
    .phd-columns.is-single,
    .master-columns.is-single {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 012 FR-001～FR-003 / FR-011：≥480px 行内三列固定网格（PhD 与 Master's 共用一组声明）。
     姓名 3.5em（63px）/ Since 5em（90px）/ 链接 6.5em（117px），与内容、视口宽窄无关；
     column-gap: 0 + justify-content: space-between 把余量等分为两个列间空白，
     即每侧 g = (W − 270px) / 2，姓名贴行内容左缘、链接贴行右缘。
     5em 由 T007 在验收浏览器实测 Since 文字宽 85.58px ≤ 90px 判定；
     固定列宽下不再需要 011 的碰撞夹取与按视口左移逻辑。 */
  @media (min-width: 480px) {
    .phd-columns li,
    .master-columns li {
      display: grid;
      grid-template-columns: 3.5em 5em 6.5em;
      column-gap: 0;
      justify-content: space-between;
    }

    .phd-columns .student-name,
    .master-columns .student-name {
      grid-column: 1;
    }

    /* margin-left: 0 覆盖基线 auto，否则自动外边距吞掉列内余量、破坏列内居中 */
    .phd-columns .grade,
    .master-columns .grade {
      grid-column: 2;
      justify-self: center;
      margin-left: 0;
      white-space: nowrap;
    }

    .phd-columns .member-link,
    .master-columns .member-link {
      grid-column: 3;
      justify-self: end;
      text-align: right;
      white-space: nowrap;
    }
  }

  /* 010 FR-009 / 011：<480px 单栏竖排——第 1 行姓名 + Since 右对齐；
     第 2 行链接独占整行、文字右对齐（012 FR-005） */
  @media (max-width: 479.98px) {
    .phd-columns .student-name,
    .master-columns .student-name {
      flex: 0 0 auto;
    }

    .phd-columns .grade,
    .master-columns .grade {
      margin-left: auto;
    }

    .phd-columns .member-link,
    .master-columns .member-link {
      order: 9;
      flex: 0 0 100%;
      margin-left: 0;
      text-align: right;
    }

  }
</style>
