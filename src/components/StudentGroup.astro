---
import type { CollectionEntry } from 'astro:content';

interface Props {
  students: CollectionEntry<'students'>[];
}

const { students } = Astro.props;

// data-model §4：按 level 分组，组内按 grade 降序（无年级排最后）
const byLevel = (level: 'phd' | 'master') =>
  students
    .filter((s) => s.data.level === level)
    .sort((a, b) => (b.data.grade ?? '').localeCompare(a.data.grade ?? ''));

const phd = byLevel('phd');
const master = byLevel('master');
---

<div class="student-groups">
  {
    phd.length > 0 ? (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <ul>
          {phd.map((s) => (
            <li>
              {s.data.url ? (
                <a href={s.data.url} target="_blank" rel="noopener">
                  {s.data.name}
                </a>
              ) : (
                <span>{s.data.name}</span>
              )}
              {s.data.github && (
                <a class="github-link" href={s.data.github} target="_blank" rel="noopener">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
              {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
              {s.data.note && <span class="note">{s.data.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <p class="empty">PhD candidates coming soon.</p>
      </div>
    )
  }

  {
    master.length > 0 ? (
      <div class="student-group">
        <h3>Master's Students</h3>
        <ul>
          {master.map((s) => (
            <li>
              {s.data.url ? (
                <a href={s.data.url} target="_blank" rel="noopener">
                  {s.data.name}
                </a>
              ) : (
                <span>{s.data.name}</span>
              )}
              {s.data.github && (
                <a class="github-link" href={s.data.github} target="_blank" rel="noopener">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
              {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
              {s.data.note && <span class="note">{s.data.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>Master's Students</h3>
        <p class="empty">Master's students coming soon.</p>
      </div>
    )
  }
</div>

<style>
  .student-groups {
    display: grid;
    /* 003 FR-010 / SC-003：轨道最小宽度不得超出容器——320px 档内容区仅 288px，
       原 minmax(320px, 1fr) 迫使轨道为 320px 宽，整组向右溢出 16px（验收实测定位）；
       min(320px, 100%) 保证轨道永不超过容器（沿用 team.astro 既有写法）。
       视口 ≥352px（容器 ≥320px）时行为与原来完全一致，2 列阈值不变，无回归 */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 32px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    color: var(--blue-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    /* 两端分布 + 两侧内收（002 FR-004 / T006）：姓名自分组左缘内收、Since/备注自分组右缘内收；
       003 FR-007 左右内距自 44px 统一收窄为 24px（左右对称）——与毕业生条目同一固定内距，
       本组件即跨区块列对齐基准（两列表姓名左边缘同线，验收 getBoundingClientRect().left 差值 ≤1px） */
    padding: 8px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  li:first-of-type {
    border-top: 1px solid var(--line);
  }

  a {
    color: var(--ink);
  }

  a:hover {
    color: var(--blue-deep);
  }

  .grade,
  .note {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* 两端分布（FR-004）：姓名居左，Since/备注推至行内收拢后的右缘；
     无年级条目仅左侧姓名，行内布局保持整齐 */
  .grade {
    margin-left: auto;
  }

  /* GitHub↗ 标签复用站点链接色板（区别于姓名链接的 ink 色） */
  .github-link {
    color: var(--blue-deep);
  }

  .github-link:hover {
    color: var(--blue);
  }

  .empty {
    color: var(--ink-soft);
  }
</style>
