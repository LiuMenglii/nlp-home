---
import type { CollectionEntry } from 'astro:content';

interface Props {
  students: CollectionEntry<'students'>[];
}

const { students } = Astro.props;

// 013 FR-004：按 level 分组，组内按数据文件条目顺序（entry id stu-### 升序）展示，
// 不再按入学年份排序
const byLevel = (level: 'phd' | 'master') =>
  students.filter((s) => s.data.level === level).sort((a, b) => a.id.localeCompare(b.id));

const phd = byLevel('phd');
const master = byLevel('master');

// 010 FR-003：PhD 名单按 ceil(n/2) 切分为左右两栏；n=1 单栏单条，不生成空栏。
// 切分不改变 byLevel 的结果（数据文件条目顺序）。
const phdColumns =
  phd.length > 1
    ? [phd.slice(0, Math.ceil(phd.length / 2)), phd.slice(Math.ceil(phd.length / 2))]
    : phd.length === 1
      ? [phd]
      : [];
const phdSingle = phd.length <= 1;

// 011 FR-001～FR-003：Master's 与 PhD 同规则，按 ceil(n/2) 切分为左右两栏；
// n=1 单栏单条（.is-single），n=0 保留既有占位分支，不生成空栏。
// 切分不改变 byLevel 的结果（数据文件条目顺序）。
const masterColumns =
  master.length > 1
    ? [
        master.slice(0, Math.ceil(master.length / 2)),
        master.slice(Math.ceil(master.length / 2)),
      ]
    : master.length === 1
      ? [master]
      : [];
const masterSingle = master.length <= 1;

// 007 FR-012：每人至多一个链接标签，按 url → github → scholar 取第一个非空字段
const linkOf = (s: CollectionEntry<'students'>) =>
  s.data.url
    ? { href: s.data.url, label: 'Homepage' }
    : s.data.github
      ? { href: s.data.github, label: 'GitHub' }
      : s.data.scholar
        ? { href: s.data.scholar, label: 'Scholar' }
        : null;
---

<div class="student-groups">
  {
    phd.length > 0 ? (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <div class:list={['phd-columns', { 'is-single': phdSingle }]}>
          {phdColumns.map((column) => (
            <ul>
              {column.map((s) => {
                const link = linkOf(s);
                return (
                  <li>
                    <span class="student-name">{s.data.name}</span>
                    <span class="direction-tags" role="list" aria-label="Research directions">
                      {s.data.directions.map((direction) => (
                        <span class="direction-tag" role="listitem">
                          {direction}
                        </span>
                      ))}
                    </span>
                    {link && (
                      <a class="member-link" href={link.href} target="_blank" rel="noopener">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>
    ) : (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <p class="empty">PhD candidates coming soon.</p>
      </div>
    )
  }

  {
    master.length > 0 ? (
      <div class="student-group">
        <h3>Master's Students</h3>
        <div class:list={['master-columns', { 'is-single': masterSingle }]}>
          {masterColumns.map((column) => (
            <ul>
              {column.map((s) => {
                const link = linkOf(s);
                return (
                  <li>
                    <span class="student-name">{s.data.name}</span>
                    <span class="direction-tags" role="list" aria-label="Research directions">
                      {s.data.directions.map((direction) => (
                        <span class="direction-tag" role="listitem">
                          {direction}
                        </span>
                      ))}
                    </span>
                    {link && (
                      <a class="member-link" href={link.href} target="_blank" rel="noopener">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>
    ) : (
      <div class="student-group">
        <h3>Master's Students</h3>
        <p class="empty">Master's students coming soon.</p>
      </div>
    )
  }
</div>

<style>
  .student-groups {
    display: grid;
    /* 007 FR-001～FR-003：PhD Candidates 与 Master's Students 在所有视口上下排列、
       各占内容区整行（不再按 320px 阈值并排）；minmax(0, 1fr) 保证轨道不超出容器，
       320px 档亦不横向溢出 */
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    color: var(--blue-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    /* 002 FR-004 / T006：内容自分组左缘内收；
       003 FR-007 左右内距统一为 24px（左右对称）——与毕业生条目同一固定内距，
       本组件即跨区块列对齐基准（两列表姓名左边缘同线，验收 getBoundingClientRect().left 差值 ≤1px） */
    padding: 8px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  li:first-of-type {
    border-top: 1px solid var(--line);
  }

  /* 013 FR-005：姓名纯文本（非链接）；≥480px 固定 3.5em 列宽（按最多 4 个汉字设计，
     4 字姓名在列内换行为既定行为），<480px 随内容自适应 */
  .student-name {
    flex: 0 0 auto;
  }

  /* 013 FR-005 / FR-014：方向标签组位于姓名与链接之间，组内按需换行；
     role="list" + aria-label 提供「一组研究方向」语义 */
  .direction-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    align-items: center;
    min-width: 0;
  }

  /* 013 FR-006：浅色 chip，与教师卡片 teacher-directions 同一视觉语言；
     长标签在自身内部换行，不截断、不省略 */
  .direction-tag {
    background: var(--sky);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  /* 007 FR-012 / FR-018：唯一链接标签沿用站点链接色板（--blue-deep，hover --blue） */
  .member-link {
    color: var(--blue-deep);
  }

  .member-link:hover {
    color: var(--blue);
  }

  .empty {
    color: var(--ink-soft);
  }

  /* 010 FR-001～FR-003 / 011：PhD 与 Master's 共用的名单两栏包装层；
     基础态单列整宽，≥768px 切换两栏（选择器并列，声明值与 010 逐条相同） */
  .phd-columns,
  .master-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .phd-columns ul,
  .master-columns ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 单栏陈列时两个 ul 连成一条连续列表，第二个列表首行不重复顶部分隔线 */
  .phd-columns ul + ul li:first-child,
  .master-columns ul + ul li:first-child {
    border-top: 0;
  }

  /* 超长姓名（含无空格拉丁串）在槽内换行，不越入相邻槽位 */
  .phd-columns .student-name,
  .master-columns .student-name {
    overflow-wrap: break-word;
  }

  /* 010 FR-001～FR-003：≥768px 两栏等宽、栏距 32px、两列顶线一致；
     与教师名片单列断点（767.98px）同阈值 */
  @media (min-width: 768px) {
    .phd-columns,
    .master-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      align-items: start;
    }

    .phd-columns ul + ul li:first-child,
    .master-columns ul + ul li:first-child {
      border-top: 1px solid var(--line);
    }

    /* n=1 时回到单列整宽，不产生空栏 */
    .phd-columns.is-single,
    .master-columns.is-single {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 013 FR-005～FR-007：≥480px 行内三轨网格（PhD 与 Master's 共用一组声明）。
     姓名 3.5em（63px）/ 方向标签组 minmax(0, 1fr) / 链接 6.5em（117px），column-gap: 10px；
     中间列用 minmax(0, 1fr) 保证长标签在列内换行而不撑开行；
     无链接行不渲染链接元素，但固定第三轨仍保留 6.5em 列宽。 */
  @media (min-width: 480px) {
    .phd-columns li,
    .master-columns li {
      display: grid;
      grid-template-columns: 3.5em minmax(0, 1fr) 6.5em;
      column-gap: 10px;
    }

    .phd-columns .student-name,
    .master-columns .student-name {
      grid-column: 1;
    }

    .phd-columns .direction-tags,
    .master-columns .direction-tags {
      grid-column: 2;
    }

    .phd-columns .member-link,
    .master-columns .member-link {
      grid-column: 3;
      justify-self: end;
      text-align: right;
      white-space: nowrap;
    }
  }

  /* 013 FR-008：<480px 单栏竖排——姓名与标签组共享可用行并按需换行，
     链接独占最后一行、文字右对齐 */
  @media (max-width: 479.98px) {
    .phd-columns .student-name,
    .master-columns .student-name {
      flex: 0 0 auto;
    }

    .phd-columns .direction-tags,
    .master-columns .direction-tags {
      flex: 1 1 0;
      min-width: 0;
    }

    .phd-columns .member-link,
    .master-columns .member-link {
      order: 9;
      flex: 0 0 100%;
      text-align: right;
    }
  }
</style>
