---
import type { CollectionEntry } from 'astro:content';

interface Props {
  students: CollectionEntry<'students'>[];
}

const { students } = Astro.props;

// data-model §4：按 level 分组，组内按 grade 降序（无年级排最后）
const byLevel = (level: 'phd' | 'master') =>
  students
    .filter((s) => s.data.level === level)
    .sort((a, b) => (b.data.grade ?? '').localeCompare(a.data.grade ?? ''));

const phd = byLevel('phd');
const master = byLevel('master');

// 007 FR-012：每人至多一个链接标签，按 url → github → scholar 取第一个非空字段
const linkOf = (s: CollectionEntry<'students'>) =>
  s.data.url
    ? { href: s.data.url, label: 'Homepage' }
    : s.data.github
      ? { href: s.data.github, label: 'GitHub' }
      : s.data.scholar
        ? { href: s.data.scholar, label: 'Scholar' }
        : null;
---

<div class="student-groups">
  {
    phd.length > 0 ? (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <ul>
          {phd.map((s) => {
            const link = linkOf(s);
            return (
              <li>
                <span class="student-name">{s.data.name}</span>
                {link && (
                  <a class="member-link" href={link.href} target="_blank" rel="noopener">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
                {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
                {s.data.note && <span class="note">{s.data.note}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>PhD Candidates</h3>
        <p class="empty">PhD candidates coming soon.</p>
      </div>
    )
  }

  {
    master.length > 0 ? (
      <div class="student-group">
        <h3>Master's Students</h3>
        <ul>
          {master.map((s) => {
            const link = linkOf(s);
            return (
              <li>
                <span class="student-name">{s.data.name}</span>
                {link && (
                  <a class="member-link" href={link.href} target="_blank" rel="noopener">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
                {s.data.grade && <span class="grade">Since {s.data.grade}</span>}
                {s.data.note && <span class="note">{s.data.note}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    ) : (
      <div class="student-group">
        <h3>Master's Students</h3>
        <p class="empty">Master's students coming soon.</p>
      </div>
    )
  }
</div>

<style>
  .student-groups {
    display: grid;
    /* 007 FR-001～FR-003：PhD Candidates 与 Master's Students 在所有视口上下排列、
       各占内容区整行（不再按 320px 阈值并排）；minmax(0, 1fr) 保证轨道不超出容器，
       320px 档亦不横向溢出 */
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    color: var(--blue-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    /* 两端分布 + 两侧内收（002 FR-004 / T006）：姓名自分组左缘内收、Since/备注自分组右缘内收；
       003 FR-007 左右内距自 44px 统一收窄为 24px（左右对称）——与毕业生条目同一固定内距，
       本组件即跨区块列对齐基准（两列表姓名左边缘同线，验收 getBoundingClientRect().left 差值 ≤1px） */
    padding: 8px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  li:first-of-type {
    border-top: 1px solid var(--line);
  }

  /* 007 FR-013 / FR-019：姓名纯文本（非链接），固定 5em 轨道（按最多 4 个汉字设计） */
  .student-name {
    flex: 0 0 5em;
  }

  /* 007 FR-012 / FR-018：唯一链接标签固定在 6.5em 列内居中，
     沿用站点链接色板（--blue-deep，hover --blue） */
  .member-link {
    flex: 0 0 6.5em;
    text-align: center;
    color: var(--blue-deep);
  }

  .member-link:hover {
    color: var(--blue);
  }

  .grade,
  .note {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* 两端分布（FR-004）：姓名居左，Since/备注推至行内收拢后的右缘；
     无年级条目仅左侧姓名，行内布局保持整齐 */
  .grade {
    margin-left: auto;
  }

  /* 007 FR-019：视口 <480px 堆叠态——姓名恢复自适应宽度，标签独占一行并左对齐；
     DOM 顺序不变，标签以 order 后置，行序为「姓名与年级 → 备注 → 标签」 */
  @media (max-width: 479.98px) {
    .student-name {
      flex: 0 0 auto;
    }

    .member-link {
      order: 9;
      flex: 0 0 100%;
      text-align: left;
    }
  }

  .empty {
    color: var(--ink-soft);
  }
</style>
