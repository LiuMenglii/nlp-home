---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const { targets, skills, email, emailSubject } = site.admissions;
const mailto = `mailto:${email}?subject=${encodeURIComponent(emailSubject)}`;
---

<section class="section" aria-labelledby="admissions-title">
  <SectionHeading title="Join Us · 招募" id="admissions-title" />
  <div class="card admissions-card">
    {
      targets && (
        <div class="admissions-targets">
          <h3>面向对象</h3>
          <p>{targets}</p>
        </div>
      )
    }
    {
      skills.length > 0 && (
        <div class="admissions-skills">
          <h3>我们期待你具备</h3>
          <ul>
            {skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      )
    }
    <p class="admissions-contact">
      有意向的同学请发送邮件（主题格式：<code>{emailSubject}</code>）：
      <a class="contact-link" href={mailto}>{email}</a>
    </p>
  </div>
</section>

<style>
  .admissions-card {
    display: grid;
    gap: 20px;
  }

  h3 {
    font-size: 1.1rem;
    color: var(--blue-deep);
    margin-bottom: 8px;
  }

  .admissions-targets p {
    margin: 0;
    white-space: pre-line;
  }

  .admissions-skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .admissions-skills li {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 16px;
    font-size: 1rem;
  }

  .admissions-contact {
    margin: 0;
  }

  .admissions-contact code {
    background: var(--sky);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.9em;
  }

  .contact-link {
    font-weight: 600;
  }
</style>
