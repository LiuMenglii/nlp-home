---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeacherCard from '../components/TeacherCard.astro';
import StudentGroup from '../components/StudentGroup.astro';
import site from '../data/site.json';

const teachers = (await getCollection('teachers')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const students = await getCollection('students');
const graduates = (await getCollection('graduates')).sort((a, b) =>
  (b.data.year ?? 0) - (a.data.year ?? 0) || a.id.localeCompare(b.id),
);

// T046：可见 UI 标签英文化（学位标签 PhD/Master，毕业生年份无中文后缀）
const degreeLabel = { phd: 'PhD', master: 'Master' } as const;
---

<BaseLayout title={`Team · ${site.groupName}`}>
  <section class="section" aria-labelledby="team-title">
    <SectionHeading title="Team" id="team-title" />

    <h3 class="group-title">Faculty</h3>
    <div class="teacher-grid">
      {teachers.map((teacher) => <TeacherCard teacher={teacher} detailed />)}
    </div>

    <div class="student-section">
      <StudentGroup students={students} />
    </div>

    <h3 class="group-title">Graduates</h3>
    {
      graduates.length > 0 ? (
        <ul class="graduate-list">
          {graduates.map((g) => (
            <li>
              <span class="grad-name">{g.data.name}</span>
              <span class="grad-meta">
                {degreeLabel[g.data.degree]}
                {g.data.year ? ` · ${g.data.year}` : ''}
              </span>
              <span class="grad-dest">
                {g.data.destination}
                {g.data.github && (
                  <a href={g.data.github} target="_blank" rel="noopener">
                    GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Graduates coming soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .group-title {
    margin: 40px 0 16px;
    font-size: 1.35rem;
    color: var(--ink);
  }

  .group-title:first-of-type {
    margin-top: 0;
  }

  .teacher-grid {
    display: grid;
    /* 桌面每行 2 张卡片；min(420px, 100%) 保证轨道最小宽度永不超过容器宽度——
       宽视口（≥~900px）维持两列，窄视口自动降为恰好贴合容器的单列，全宽度区间连续自适应 */
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: 16px;
  }

  .student-section {
    margin-top: 40px;
  }

  .graduate-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .graduate-list li {
    /* ≥768px 三列对齐（FR-003）：前两列为与内容无关的固定轨道宽——姓名列按 ≤4 汉字 + 余量、
       学位·年份列按最宽现值 "Master · 2025" + 余量，第 3 列 minmax(0,1fr) 弹性吸收剩余宽度
       并允许长去向在列内换行；year 为空的行第 2 列仅显示学位、轨道仍占位，跨行对齐不受影响 */
    display: grid;
    grid-template-columns: 4.5em 6.5em minmax(0, 1fr);
    align-items: baseline;
    column-gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 767.98px) {
    /* <768px 降级为紧凑流式（FR-003）：三个字段各占一行，同类字段起始位置跨行一致，不溢出 */
    .graduate-list li {
      display: block;
    }

    .graduate-list li > span {
      display: block;
    }
  }

  .graduate-list li:first-child {
    border-top: 1px solid var(--line);
  }

  .grad-name {
    font-weight: 500;
    color: var(--ink);
  }

  .grad-meta,
  .grad-dest {
    color: var(--ink-soft);
  }

  .grad-dest a {
    margin-left: 8px;
  }

  .empty {
    color: var(--ink-soft);
  }
</style>
