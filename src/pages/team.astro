---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeacherCard from '../components/TeacherCard.astro';
import StudentGroup from '../components/StudentGroup.astro';
import site from '../data/site.json';

const teachers = (await getCollection('teachers')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const students = await getCollection('students');
// FR-012 渲染排序：毕业年份降序 → 同年份 PhD 在 Master 前 → 无年份条目最后（组内 PhD 在前）
// → 同排序键以 file loader 注入的零填充 id（gra-001…）字典序 tiebreak（id 序 = 数据文件条目序）
const degreeOrder = { phd: 0, master: 1 } as const;
const graduates = (await getCollection('graduates')).sort((a, b) => {
  const yearA = a.data.year ?? null;
  const yearB = b.data.year ?? null;
  if ((yearA === null) !== (yearB === null)) return yearA === null ? 1 : -1;
  if (yearA !== null && yearB !== null && yearA !== yearB) return yearB - yearA;
  if (a.data.degree !== b.data.degree) {
    return degreeOrder[a.data.degree] - degreeOrder[b.data.degree];
  }
  return a.id.localeCompare(b.id);
});

// T046：可见 UI 标签英文化（学位标签 PhD/Master，毕业生年份无中文后缀）
const degreeLabel = { phd: 'PhD', master: 'Master' } as const;
---

<BaseLayout title={`Team · ${site.groupName}`}>
  <section class="section" aria-labelledby="team-title">
    <SectionHeading title="Team" id="team-title" />

    <h3 class="group-title">Faculty</h3>
    <div class="teacher-grid">
      {teachers.map((teacher) => <TeacherCard teacher={teacher} detailed />)}
    </div>

    <div class="student-section">
      <StudentGroup students={students} />
    </div>

    <h3 class="group-title">Graduates</h3>
    {
      graduates.length > 0 ? (
        <ul class="graduate-list">
          {graduates.map((g) => (
            <li>
              <span class="grad-name">{g.data.name}</span>
              <span class="grad-degree">{degreeLabel[g.data.degree]}</span>
              <span class:list={['grad-year', { 'is-empty': !g.data.year }]}>{g.data.year ?? ''}</span>
              <span class="grad-dest">{g.data.destination}</span>
              <span
                class:list={[
                  'grad-links',
                  { 'is-empty': !g.data.url && !g.data.github },
                ]}
              >
                {g.data.url && (
                  <a href={g.data.url} target="_blank" rel="noopener">
                    Homepage <span aria-hidden="true">↗</span>
                  </a>
                )}
                {g.data.github && (
                  <a href={g.data.github} target="_blank" rel="noopener">
                    GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Graduates coming soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .group-title {
    margin: 40px 0 16px;
    font-size: 1.35rem;
    color: var(--ink);
  }

  .group-title:first-of-type {
    margin-top: 0;
  }

  .teacher-grid {
    display: grid;
    /* 003 FR-002 显式分档列数：≥1280px 每行 3 张；768–<1280px 每行 2 张；
       576–<768px 与 <576px 每行 1 张。断点数值以 spec FR-001 为唯一规范源，
       半开区间 .98px 写法保证边界紧下方即切换；minmax(0,1fr) 保证同行卡片等宽 */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 1279.98px) {
    .teacher-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .teacher-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }

  .student-section {
    margin-top: 40px;
  }

  .graduate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    /* 满宽列表（2026-10-12 第三轮用户裁定）：铺满内容区，避免右侧无意义空白
       与因空间不足导致的文字换行；<768px 降级规则见下方媒体查询 */
  }

  .graduate-list li {
    /* ≥768px 五列混合对齐（FR-003 / 2026-10-12 第三轮用户裁定）：
       姓名/学位/年份固定轨道左对齐；去向列 minmax(0,1fr) 弹性吸收且居中
       （左右留大间距，容纳较长去向名称；更长内容列内换行收纳）；
       链接列固定轨道、标签右对齐贴行右缘 padding。
       固定宽禁用 max-content——后者随各行内容变宽、破坏跨行对齐；
       year 为空的行第 3 列留空占位（空 span 仍占据轨道） */
    display: grid;
    /* 链接列收窄为 Homepage↗ 实际文本宽（实测约 106px ≈ 5.9em，取 6.5em 留少量余量；
       2026-10-13 用户裁定：列宽与文字宽度大致相同），释放的宽度并入下方 column-gap */
    grid-template-columns: 4.5em 4em 3em minmax(0, 1fr) 6.5em;
    align-items: baseline;
    /* 字段间隙加大（用户裁定）：链接列收窄释放的宽度全部转为列间距 */
    column-gap: 38px;
    /* 左右 padding 对称（002 用户裁定：姓名距表格左缘＝标签距表格右缘）；
       003 FR-007 自 44px 统一收窄为 24px——与在读学生条目（StudentGroup）同一固定内距，
       使两列表姓名左边缘落在同一竖直线（跨区块列对齐） */
    padding: 10px 24px;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 767.98px) {
    /* <768px 三段式（003 FR-006 / CHK010）：
       第 1 行：姓名居左；学位 margin-left:auto 推向行右端（文字右对齐），
       年份紧随学位之后（flex item 默认收缩自适应 → 容器宽＝数字宽、右对齐贴行右缘），
       学位与年份之间隔 column-gap（≈一个词空格）；
       第 2 行：去向 flex: 0 0 100% 占整宽、左对齐；
       第 3 行：链接标签占整宽、左对齐（见下方 .grad-links 规则）。
       字段缺失的空行（无年份 / 无链接标签）经 .is-empty 不渲染、行自动塌缩（FR-008） */
    .graduate-list li {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.25em;
      row-gap: 0;
    }

    .grad-degree {
      margin-left: auto;
    }

    .grad-dest {
      flex: 0 0 100%;
    }

    /* 链接行（003 2026-10-15 裁定）：标签保持横向并列（flex 负责间距与换行）、左对齐，
       沿用既有高特异度选择器原地改写 flex-end → flex-start 并补 flex: 0 0 100%，
       不另设低特异度 .grad-links 规则（单一规则来源，不依赖声明顺序） */
    .graduate-list li > .grad-links {
      display: flex;
      justify-content: flex-start;
      flex: 0 0 100%;
    }

    .graduate-list li > .is-empty {
      display: none;
    }
  }

  .graduate-list li:first-child {
    border-top: 1px solid var(--line);
  }

  .grad-name {
    font-weight: 500;
    color: var(--ink);
  }

  .grad-degree,
  .grad-year,
  .grad-dest {
    color: var(--ink-soft);
  }

  /* 去向列居中（2026-10-12 第三轮用户裁定）：各行中心点在同一直线上，
     左右留大间距——部分去向名称较长，更长内容在列内换行收纳（FR-003）。
     仅 ≥768px 五列形态生效；<768px 降级为堆叠态时去向行保持左对齐（契约 §2），
     否则该居中会泄漏进降级态，造成姓名/学位/年份左对齐、去向居中、标签右对齐的错乱 */
  @media (min-width: 768px) {
    .grad-dest {
      text-align: center;
    }
  }

  /* 链接列（FR-011）：Homepage↗ / GitHub↗ 标签并列于独立末列，
     右对齐贴行右缘（第三轮裁定），间距沿用 .teacher-links 的 gap 语义 */
  .grad-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    justify-content: flex-end;
  }

  .empty {
    color: var(--ink-soft);
  }
</style>
